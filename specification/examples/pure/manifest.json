      "file": "pure/valid/arithmetic.weave",
      "expect": "ACCEPT",
      "rules": [
        "P0-FILE-1",
        "P0-TYPE-2",
        "P0-PATH-1",
        "P0-REC-1"
      ],
      "lesson": "Arithmetic, comparisons, div/mod and terminal if/else type-check."
    },
